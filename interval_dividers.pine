//@version=6
indicator("HTF Toolkit (Dividers + HTF Candles + Day Labels)", shorttitle="HTF Toolkit", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=100)

MAX_LINES = 500
RESERVED_HTF_WICKS = 4

var line[] dividerLines = array.new_line()
var line[] timestampLines = array.new_line()

// Shared timeframe selector
var g_SHARED = "Shared Timeframe"
sharedTf = input.timeframe("D", "HTF timeframe", group=g_SHARED)

// 1) Day-of-week labels at noon
var g_DAYS = "Day Labels"
showDayLabels = input.bool(true, "Show day labels at 12:00", group=g_DAYS)
dayLabelColor = input.color(color.new(color.black, 0), "Text color", group=g_DAYS)
dayLabelBg = input.color(color.new(color.gray, 80), "Background", group=g_DAYS)
dayLabelSize = input.string("Tiny", "Label size", options=["Tiny", "Small", "Normal"], group=g_DAYS)

labelSize = switch dayLabelSize
    "Small" => size.small
    "Normal" => size.normal
    => size.tiny

isNoonBar = timeframe.isintraday and hour == 12 and minute == 0
newNoon = isNoonBar and not isNoonBar[1]

isDayLabelBar = showDayLabels and newNoon

// Use plotshape(location.bottom) so day labels stay pinned to the chart bottom
// instead of floating with price scaling.
plotshape(isDayLabelBar and dayofweek == dayofweek.monday, title="Monday Label", text="MONDAY", style=shape.labelup, location=location.bottom, size=labelSize, color=dayLabelBg, textcolor=dayLabelColor)
plotshape(isDayLabelBar and dayofweek == dayofweek.tuesday, title="Tuesday Label", text="TUESDAY", style=shape.labelup, location=location.bottom, size=labelSize, color=dayLabelBg, textcolor=dayLabelColor)
plotshape(isDayLabelBar and dayofweek == dayofweek.wednesday, title="Wednesday Label", text="WEDNESDAY", style=shape.labelup, location=location.bottom, size=labelSize, color=dayLabelBg, textcolor=dayLabelColor)
plotshape(isDayLabelBar and dayofweek == dayofweek.thursday, title="Thursday Label", text="THURSDAY", style=shape.labelup, location=location.bottom, size=labelSize, color=dayLabelBg, textcolor=dayLabelColor)
plotshape(isDayLabelBar and dayofweek == dayofweek.friday, title="Friday Label", text="FRIDAY", style=shape.labelup, location=location.bottom, size=labelSize, color=dayLabelBg, textcolor=dayLabelColor)
plotshape(isDayLabelBar and dayofweek == dayofweek.saturday, title="Saturday Label", text="SATURDAY", style=shape.labelup, location=location.bottom, size=labelSize, color=dayLabelBg, textcolor=dayLabelColor)
plotshape(isDayLabelBar and dayofweek == dayofweek.sunday, title="Sunday Label", text="SUNDAY", style=shape.labelup, location=location.bottom, size=labelSize, color=dayLabelBg, textcolor=dayLabelColor)

// 2) + 3) HTF dividers and right-side HTF candles
var g_DIVIDERS = "HTF Dividers"
showDividers = input.bool(true, "Show HTF dividers", group=g_DIVIDERS)
dividerColor = input.color(color.new(color.silver, 0), "Line color", group=g_DIVIDERS)
dividerWidth = input.int(1, "Line width", minval=1, maxval=5, group=g_DIVIDERS)
dividerStyleInput = input.string("Dotted", "Line style", options=["Solid", "Dashed", "Dotted"], group=g_DIVIDERS)
maxDividers = input.int(200, "Max dividers", minval=10, maxval=400, group=g_DIVIDERS)

dividerStyle = switch dividerStyleInput
    "Solid" => line.style_solid
    "Dashed" => line.style_dashed
    => line.style_dotted

newIntervalBar = ta.change(time(sharedTf)) != 0

if showDividers and newIntervalBar and barstate.isnew
    divider = line.new(bar_index, low, bar_index, high, xloc=xloc.bar_index, extend=extend.both, color=dividerColor, style=dividerStyle, width=dividerWidth)
    array.push(dividerLines, divider)

if not showDividers and array.size(dividerLines) > 0
    while array.size(dividerLines) > 0
        line.delete(array.shift(dividerLines))

while array.size(dividerLines) > maxDividers
    line.delete(array.shift(dividerLines))

// 4-candle HTF display (left→right: oldest to most recent)
var g_CANDLES = "HTF Candle Display"
showHtfCandles = input.bool(true, "Show HTF candles on right", group=g_CANDLES)
baseOffset = input.int(10, "Start offset (bars to right)", minval=2, maxval=200, group=g_CANDLES)
candleWidth = input.int(6, "Candle width", minval=1, maxval=50, group=g_CANDLES)
candleGap = input.int(2, "Gap between candles", minval=0, maxval=50, group=g_CANDLES)

var g_STYLE = "HTF Candle Style"
upColor = input.color(color.new(color.green, 0), "Up color", group=g_STYLE)
downColor = input.color(color.new(color.black, 0), "Down color", group=g_STYLE)
wickColor = input.color(color.new(color.gray, 0), "Wick color", group=g_STYLE)
bodyBorderWidth = input.int(1, "Body border width", minval=0, maxval=10, group=g_STYLE)
wickWidth = input.int(1, "Wick width", minval=1, maxval=10, group=g_STYLE)

[o0, h0, l0, c0] = request.security(syminfo.tickerid, sharedTf, [open, high, low, close], barmerge.gaps_off, barmerge.lookahead_off)
[o1, h1, l1, c1] = request.security(syminfo.tickerid, sharedTf, [open[1], high[1], low[1], close[1]], barmerge.gaps_off, barmerge.lookahead_off)
[o2, h2, l2, c2] = request.security(syminfo.tickerid, sharedTf, [open[2], high[2], low[2], close[2]], barmerge.gaps_off, barmerge.lookahead_off)
[o3, h3, l3, c3] = request.security(syminfo.tickerid, sharedTf, [open[3], high[3], low[3], close[3]], barmerge.gaps_off, barmerge.lookahead_off)

var box body0 = box.new(na, na, na, na, bgcolor=na)
var box body1 = box.new(na, na, na, na, bgcolor=na)
var box body2 = box.new(na, na, na, na, bgcolor=na)
var box body3 = box.new(na, na, na, na, bgcolor=na)
var line wick0 = line.new(na, na, na, na)
var line wick1 = line.new(na, na, na, na)
var line wick2 = line.new(na, na, na, na)
var line wick3 = line.new(na, na, na, na)

f_setHtfCandle(_body, _wick, _offsetStep, _o, _h, _l, _c) =>
    leftX = bar_index + baseOffset + _offsetStep * (candleWidth + candleGap)
    rightX = leftX + candleWidth
    wickX = leftX + int(math.floor(candleWidth / 2))
    isUp = _c >= _o

    line.set_color(_wick, wickColor)
    line.set_width(_wick, wickWidth)
    line.set_x1(_wick, wickX)
    line.set_x2(_wick, wickX)
    line.set_y1(_wick, _h)
    line.set_y2(_wick, _l)
    line.set_extend(_wick, extend.none)

    box.set_lefttop(_body, leftX, isUp ? _c : _o)
    box.set_rightbottom(_body, rightX, isUp ? _o : _c)
    box.set_bgcolor(_body, isUp ? upColor : downColor)
    box.set_border_color(_body, wickColor)
    box.set_border_width(_body, bodyBorderWidth)

if showHtfCandles
    // Oldest (3 bars back) on the left, current bar on the far right.
    f_setHtfCandle(body3, wick3, 0, o3, h3, l3, c3)
    f_setHtfCandle(body2, wick2, 1, o2, h2, l2, c2)
    f_setHtfCandle(body1, wick1, 2, o1, h1, l1, c1)
    f_setHtfCandle(body0, wick0, 3, o0, h0, l0, c0)
else
    box.set_bgcolor(body0, na)
    box.set_bgcolor(body1, na)
    box.set_bgcolor(body2, na)
    box.set_bgcolor(body3, na)
    box.set_border_color(body0, na)
    box.set_border_color(body1, na)
    box.set_border_color(body2, na)
    box.set_border_color(body3, na)
    line.set_color(wick0, na)
    line.set_color(wick1, na)
    line.set_color(wick2, na)
    line.set_color(wick3, na)

// 4) Optional vertical timestamps (3)
var g_VERTICAL = "Timestamps"
vUnlimited = input.bool(false, "Unlimited", tooltip="Unlimited shows as many selected timestamp lines as possible, up to TradingView line limits.", group=g_VERTICAL)

useV1 = input.bool(false, "Enable V1 Session", inline="V1", group=g_VERTICAL)
v1 = input.session("0000-0001", "", inline="V1", group=g_VERTICAL)
v1Color = input.color(color.new(color.gray, 0), "", inline="V1", group=g_VERTICAL)

useV2 = input.bool(false, "Enable V2 Session", inline="V2", group=g_VERTICAL)
v2 = input.session("0800-0801", "", inline="V2", group=g_VERTICAL)
v2Color = input.color(color.new(color.gray, 0), "", inline="V2", group=g_VERTICAL)

useV3 = input.bool(false, "Enable V3 Session", inline="V3", group=g_VERTICAL)
v3 = input.session("1200-1201", "", inline="V3", group=g_VERTICAL)
v3Color = input.color(color.new(color.gray, 0), "", inline="V3", group=g_VERTICAL)

vLineWidth = input.int(1, "Vertical line width", minval=1, maxval=5, group=g_VERTICAL)
vLineLimit = input.int(200, "Max timestamp lines", minval=20, maxval=400, group=g_VERTICAL)

f_inSession(_session) => not na(time(timeframe.period, _session))
f_newSessionStart(_session) => f_inSession(_session) and not f_inSession(_session)[1]

f_drawSessionLine(_enabled, _session, _color) =>
    if _enabled and f_newSessionStart(_session) and barstate.isnew
        l = line.new(bar_index, low, bar_index, high, xloc=xloc.bar_index, extend=extend.both, color=_color, width=vLineWidth)
        array.push(timestampLines, l)

f_drawSessionLine(useV1, v1, v1Color)
f_drawSessionLine(useV2, v2, v2Color)
f_drawSessionLine(useV3, v3, v3Color)

if not useV1 and not useV2 and not useV3 and array.size(timestampLines) > 0
    while array.size(timestampLines) > 0
        line.delete(array.shift(timestampLines))

requestedTimestampCap = vUnlimited ? MAX_LINES : vLineLimit
availableForTimestamps = math.max(0, MAX_LINES - RESERVED_HTF_WICKS - array.size(dividerLines))
timestampCap = math.min(requestedTimestampCap, availableForTimestamps)

while array.size(timestampLines) > timestampCap
    line.delete(array.shift(timestampLines))

while array.size(dividerLines) + array.size(timestampLines) + RESERVED_HTF_WICKS > MAX_LINES
    if array.size(dividerLines) > 0
        line.delete(array.shift(dividerLines))
    else if array.size(timestampLines) > 0
        line.delete(array.shift(timestampLines))
    else
        break
